        "showLabels": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "title": "Live Aegis API Container Logs",
      "type": "logs",
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "{container=\"aegis-api\"}",
          "queryType": "range",
          "refId": "A"
        }
      ]
    }
